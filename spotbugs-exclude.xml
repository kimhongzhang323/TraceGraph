<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for TraceGraph.

  EI_EXPOSE_REP / EI_EXPOSE_REP2 on records: Java records are transparent data
  carriers by design. SpotBugs flags List/Map/Throwable accessors as mutable
  exposure, but for these value-object records the accessor IS the contract.
  Suppressed across the board; callers must not mutate returned collections.

  MS_EXPOSE_REP on singleton fields: no-op/noop singleton instances (INSTANCE)
  are intentionally returned directly — immutable by construction.
-->
<FindBugsFilter>

  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Package name="~io\.tracegraph\..*"/>
  </Match>

  <Match>
    <Bug pattern="MS_EXPOSE_REP"/>
    <Package name="~io\.tracegraph\..*"/>
  </Match>

  <!--
    SQL_INJECTION_JDBC on Jdbc*Store classes: table names are construction-time
    configuration, not user input. JDBC parameterization only works for values,
    not identifiers (table/column names), so string interpolation is unavoidable.
  -->
  <Match>
    <Bug pattern="SQL_INJECTION_JDBC"/>
    <Or>
      <Class name="io.tracegraph.runtime.JdbcCheckpointStore"/>
      <Class name="io.tracegraph.memory.JdbcMemoryStore"/>
      <Class name="io.tracegraph.observability.replay.JdbcTraceStore"/>
    </Or>
  </Match>

</FindBugsFilter>
