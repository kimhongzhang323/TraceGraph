<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for TraceGraph.

  EI_EXPOSE_REP / EI_EXPOSE_REP2 on records: Java records are transparent data
  carriers by design. SpotBugs flags List/Map/Throwable accessors as mutable
  exposure, but for these value-object records the accessor IS the contract.
  Suppressed across the board; callers must not mutate returned collections.

  MS_EXPOSE_REP on singleton fields: no-op/noop singleton instances (INSTANCE)
  are intentionally returned directly — immutable by construction.
-->
<FindBugsFilter>

  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Package name="~io\.tracegraph\..*"/>
  </Match>

  <Match>
    <Bug pattern="MS_EXPOSE_REP"/>
    <Package name="~io\.tracegraph\..*"/>
  </Match>

  <!--
    SQL_INJECTION_JDBC on Jdbc*Store classes: table names are construction-time
    configuration, not user input. JDBC parameterization only works for values,
    not identifiers (table/column names), so string interpolation is unavoidable.
  -->
  <Match>
    <Bug pattern="SQL_INJECTION_JDBC"/>
    <Or>
      <Class name="io.tracegraph.runtime.JdbcCheckpointStore"/>
      <Class name="io.tracegraph.memory.JdbcMemoryStore"/>
      <Class name="io.tracegraph.observability.replay.JdbcTraceStore"/>
      <Class name="io.tracegraph.rag.PgVectorStore"/>
    </Or>
  </Match>

  <!--
    JMH-generated benchmark classes (jmh_generated package) contain padding
    fields (p1..p255) by design — anti-false-sharing layout. Not our code.
  -->
  <Match>
    <Package name="~.*jmh_generated.*"/>
  </Match>

  <!--
    PATH_TRAVERSAL_IN on BenchReport.main: this is a CLI tool that takes a
    file path argument by design. Not a remote-input vulnerability.
  -->
  <Match>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
    <Class name="io.tracegraph.bench.BenchReport"/>
  </Match>

  <!--
    POTENTIAL_XML_INJECTION on EvalReport.toJUnitXml: every appended value
    flows through the local escape() helper, which replaces &, <, >, and ".
    SpotBugs taint analysis doesn't follow custom escapers — false positive.
  -->
  <Match>
    <Bug pattern="POTENTIAL_XML_INJECTION"/>
    <Class name="io.tracegraph.eval.EvalReport"/>
  </Match>

  <!--
    PREDICTABLE_RANDOM on RetryingLlmClient: jitter for exponential backoff is
    not a security concern. ThreadLocalRandom is the right tool here.
    Same applies to SamplingTraceStore: statistical trace sampling, not crypto.
  -->
  <Match>
    <Bug pattern="PREDICTABLE_RANDOM"/>
    <Or>
      <Class name="io.tracegraph.connectors.llm.RetryingLlmClient"/>
      <Class name="io.tracegraph.observability.replay.SamplingTraceStore"/>
    </Or>
  </Match>

  <!--
    RV_RETURN_VALUE_IGNORED_BAD_PRACTICE on RateLimitedLlmClient.acquire:
    awaitNanos' remaining-time result is deliberately unused — whether the wait
    was signalled, timed out, or woke spuriously, the loop refills the bucket
    and re-checks the token count. Using the value would add no correctness.
  -->
  <Match>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
    <Class name="io.tracegraph.connectors.llm.RateLimitedLlmClient"/>
    <Method name="acquire"/>
  </Match>

</FindBugsFilter>
